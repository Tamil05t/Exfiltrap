{
  "build": {
    "beforeDevCommand": "",
    "devPath": "http://127.0.0.1:5050",
    "beforeBuildCommand": "",
    "distDir": "../../exfiltrap/dashboard/templates",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "ExFilTrap",
    "version": "1.0.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "ExFilTrap — DNS Exfiltration Monitor",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "url": "waiting.html"
      }
    ],
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "bundle": {
      "active": true,
      "identifier": "org.exfiltrap.desktop",
      "category": "Security",
      "shortDescription": "DNS tunneling & slow-drip exfiltration detection",
      "longDescription": "ExFilTrap detects covert DNS tunneling and slow-drip data exfiltration with stateful session analysis and automated firewall mitigation. The desktop app bundles the detection engine and starts it with one root authorization.",
      "resources": [
        "../../dist/exfiltrap/*"
      ],
      "targets": [
        "deb",
        "appimage"
      ],
      "icon": [
        "icons/icon.png"
      ]
    }
  }
}
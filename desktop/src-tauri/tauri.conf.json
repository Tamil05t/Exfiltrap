{
  "$schema": "https://schema.tauri.app/config/1",
  "productName": "ExFilTrap",
  "version": "1.0.0",
  "identifier": "org.exfiltrap.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5050",
    "beforeBuildCommand": "",
    "frontendDist": "../exfiltrap/dashboard/templates"
  },
  "app": {
    "windows": [
      {
        "title": "ExFilTrap — DNS Exfiltration Monitor",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "url": "http://127.0.0.1:5050"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Security",
    "shortDescription": "DNS tunneling & slow-drip exfiltration detection",
    "longDescription": "ExFilTrap detects covert DNS tunneling and slow-drip data exfiltration with stateful session analysis and automated firewall mitigation. This is the unprivileged desktop monitor for the ExFilTrap service.",
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": ["icons/icon.png"]
  }
}

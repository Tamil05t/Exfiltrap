.venv/
__pycache__/
*.pyc
.pytest_cache/
data/exfiltrap.db
*.sqlite3

# transient lab helpers
tools/.*askpass*
# scratch output from tooling/debug sessions
_*.txt
_*.log
# databases and state
data/*.db
data/*.db-wal
data/*.db-shm
data/*.state.json
# desktop build outputs
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# python
*.egg-info/
desktop/src-tauri/resources/
# pyinstaller + appimage build outputs (regenerated by the build scripts;
# committing them ships STALE dashboard templates — e.g. the old v2.0 UI)
dist/
dist-engine/
build/
build-engine/
dist-appimage/
*.spec.bak
# flatpak build staging (created by packaging/flatpak/build-flatpak.sh)
packaging/flatpak/engine-prebuilt/
packaging/flatpak/app-prebuilt/
packaging/flatpak/.flatpak-builder/
packaging/flatpak/build-dir/
packaging/flatpak/repo/
packaging/flatpak/*.flatpak
# arch build outputs
packaging/arch/*.pkg.tar.zst
packaging/arch/src/
packaging/arch/pkg/
# agent/assistant working data for this project (session memory + scratch).
# Project data, not source: it changes on every session and would only add
# churn to the history.
.workbuddy-ai/
# editor-specific ignore list (regenerated per tool, not shared)
.zcodeignore
